events {
    worker_connections 1024;
}

http {
    upstream backend {
        server {{ o11y__mimir_config_install.name }}-1:8080 max_fails=1 fail_timeout=1s;
        server {{ o11y__mimir_config_install.name }}-2:8080 max_fails=1 fail_timeout=1s;
        server {{ o11y__mimir_config_install.name }}-3:8080 max_fails=1 fail_timeout=1s backup;
    }

    server {
        listen {{ o11y__nginx_config_install.container_port }};
        access_log /dev/null;
        location / {
            proxy_pass http://backend;
        }
        location /alertmanager {
            proxy_set_header X-Scope-OrgID demo;
            proxy_pass http://backend;
        }
    }
}
